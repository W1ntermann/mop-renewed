# Resend — листи сповіщення (https://resend.com)
RESEND_API_KEY=
# Відправник; для продакшену потрібен верифікований домен, напр. "Моя особлива планета <hello@mop.com.ua>"
RESEND_FROM=
# Куди сповіщувати організатора про нові реєстрації (за замовчуванням — з lib/site-data.ts)
NOTIFY_EMAIL=

# Google Sheets — таблиця реєстрацій (Service Account з Google Cloud Console)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Приватний ключ service account; \n усередині рядка підтримуються
GOOGLE_PRIVATE_KEY=
# ID таблиці з URL: https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID=
